{
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/wtpool/scripts/wtpool.mjs", "hook", "create"], "timeout": 600 }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/skills/wtpool/scripts/wtpool.mjs", "hook", "remove"] }
        ]
      }
    ]
  }
}
